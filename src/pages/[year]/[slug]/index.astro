---
import { getCollection, type CollectionEntry } from "astro:content";
import RevealSlideLayout from "src/layouts/RevealSlideLayout.astro";
import { compileSlide } from "src/lib/slide-engines";

export async function getStaticPaths() {
  const slides = await getCollection("slides");
  return slides.map((slide) => {
    const match = slide.id.match(
      /^(?<year>\d{4})\/(?<slug>[a-z0-9]+(?:-[a-z0-9]+)*)$/,
    );
    if (!match?.groups) {
      throw new Error(
        `Invalid slide id "${slide.id}". Expected a path like "2026/my-slide".`,
      );
    }

    const { year, slug } = match.groups;
    if (String(slide.data.publishedAt.getUTCFullYear()) !== year) {
      throw new Error(
        `Slide "${slide.id}" must have a publishedAt date in ${year}.`,
      );
    }

    return {
      params: { year, slug },
      props: { slide },
    };
  });
}

type Props = {
  slide: CollectionEntry<"slides">;
};

const { slide } = Astro.props;
if (slide.body === undefined) {
  throw new Error(`Slide "${slide.id}" has no Markdown body.`);
}

switch (slide.data.engine) {
  case "reveal":
    break;
  default:
    slide.data.engine satisfies never;
    throw new Error(`Unsupported slide engine: ${String(slide.data.engine)}`);
}

const html = await compileSlide(slide.data.engine, slide.body);
---

<RevealSlideLayout
  title={slide.data.title}
  description={slide.data.description}
  theme={slide.data.theme}
  reveal={slide.data.reveal}
  embedTwitter={slide.data.embedTwitter}
>
  <Fragment set:html={html} />
</RevealSlideLayout>
