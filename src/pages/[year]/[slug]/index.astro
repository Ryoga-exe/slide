---
import { getCollection, type CollectionEntry } from "astro:content";
import SlideLayout from "src/layouts/SlideLayout.astro";
import { compileSlide } from "src/lib/slide-engines";
import { parseSlideId } from "src/lib/slide-paths";

export async function getStaticPaths() {
  const slides = await getCollection("slides");
  return slides.map((slide) => {
    const params = parseSlideId(slide.id);
    if (String(slide.data.publishedAt.getUTCFullYear()) !== params.year) {
      throw new Error(
        `Slide "${slide.id}" must have a publishedAt date in ${params.year}.`,
      );
    }

    return {
      params,
      props: { slide },
    };
  });
}

type Props = {
  slide: CollectionEntry<"slides">;
};

const { slide } = Astro.props;
if (slide.body === undefined) {
  throw new Error(`Slide "${slide.id}" has no Markdown body.`);
}
const html = await compileSlide(slide.data.engine, slide.body);
---

{
  slide.data.engine === "reveal" && (
    <SlideLayout
      title={slide.data.title}
      description={slide.data.description}
      theme={slide.data.theme}
      reveal={slide.data.reveal}
      embedTwitter={slide.data.embedTwitter}
    >
      <Fragment set:html={html} />
    </SlideLayout>
  )
}
