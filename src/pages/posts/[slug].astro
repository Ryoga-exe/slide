---
import { getCollection } from "astro:content";
import { parseSlideId, slideUrl } from "../../lib/slide-paths";

export async function getStaticPaths() {
  const slides = await getCollection("slides");
  return slides.map((slide) => {
    const { slug } = parseSlideId(slide.id);
    return {
      params: { slug },
      props: { destination: slideUrl(slide.id) },
    };
  });
}

type Props = {
  destination: string;
};

return Astro.redirect(Astro.props.destination, 301);
---
